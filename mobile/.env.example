# Zentra mobile build config.
#
# Copy this file to `.env` (gitignored) and fill in the values, then build/run
# with:
#
#   flutter run --dart-define-from-file=.env
#
# A `--dart-define=KEY=VALUE` passed on the same command line overrides the
# file value, which is handy for swapping the API host per device.

# Backend REST API.
#   Android emulator -> http://10.0.2.2:4000
#   Physical device  -> http://<your-lan-ip>:4000
API_BASE_URL=http://localhost:4000

# Firebase client config for push notifications (FCM).
# Firebase console -> Project settings -> General -> Your apps -> SDK setup.
# Leave these empty to keep push inert: the app still builds and signs in,
# the in-app notification inbox keeps working.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# Optional Firebase values.
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=

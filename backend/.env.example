PORT=4000
NODE_ENV=development

# Supabase (project URL + anon key from your own project — the anon key is
# public/RLS-scoped but still not committed; fill it in locally). Server admin
# writes require SUPABASE_SERVICE_ROLE_KEY (never commit; add to .env locally).
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (Supabase connection string — set with your DB password)
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.haivwhvhfzzzbztufcsn.supabase.co:5432/postgres"

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=60m
JWT_REFRESH_TTL=7d

# Contact-number encryption (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; when unset locally, contact numbers are stored in
# plaintext with a startup warning. Losing this key makes existing values
# unreadable, so store it in the deployment secret manager.
CONTACT_ENCRYPTION_KEY=

# Firebase service-account JSON for push notifications (raw JSON or base64).
# Optional: when empty, push delivery is disabled and the app falls back to the
# in-app notification inbox. Get it from Firebase console → Project settings →
# Service accounts → Generate new private key. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

WEB_ORIGIN=http://localhost:3000
MOBILE_ORIGIN=msat-zentra://app

STORAGE_BUCKET=zentra-docs
# Per-type buckets (optional — each falls back to STORAGE_BUCKET when unset).
# Session documentation (nurse / guidance file attachments at
# /nurse/referrals/clinic) uses the referral bucket, NOT the SF10 bucket.
SF10_STORAGE_BUCKET=zentra-docs
REFERRAL_STORAGE_BUCKET=referral-docs
OCR_WORKER_URL=

# Upstash Redis (REST over TLS) — response caching for read-heavy routes.
# Get these from your Upstash database dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# Reverse-proxy hops to trust for req.ip (admin presence globe geolocation).
# Leave unset in local dev; production defaults to 1.
# TRUST_PROXY=1
